# ---------------------------------------------------------------------------
# OTTO — variáveis de ambiente
# Copie para .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# Segurança -----------------------------------------------------------------
# Token exigido no header x-otto-token de todas as rotas /api.
# Se ficar vazio, o servidor GERA um token no primeiro boot e o salva em
# otto_workspace/.otto_token (permissão 0600). O frontend recebe o token
# automaticamente pela meta tag <meta name="otto-token"> do HTML.
OTTO_ACCESS_TOKEN=""

# Limite de requisições por minuto por IP nas rotas /api (0 desativa).
OTTO_RATE_LIMIT_PER_MIN="600"

# IA primária (ROTA A) — Groq ------------------------------------------------
# Modelos: openai/gpt-oss-120b (raciocínio, ferramentas) e openai/gpt-oss-20b
# (rápido/barato). Os Llama 3.x foram desligados na Groq em 16/08/2026.
AI_PROVIDER="groq"
AI_MODEL="openai/gpt-oss-120b"
AI_MODEL_FAST="openai/gpt-oss-20b"
GROQ_API_KEY=""
# Troque só se usar um proxy compatível com a API da Groq.
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Fallback — Google Gemini ------------------------------------------------
GEMINI_API_KEY=""

# ROTA B — provedor especializado em texto & código ----------------------
TEXT_CODE_API_KEY=""
TEXT_CODE_API_URL="https://api.groq.com/openai/v1"
TEXT_CODE_API_MODEL="openai/gpt-oss-120b"
MAX_AGENT_STEPS="12"
MAX_RETRIES="3"
MAX_EXECUTION_TIME="30000"

# Mídia ---------------------------------------------------------------------
# Opcional: caminho do binário do ffmpeg. Sem isso, o OTTO procura em
# node_modules/ffmpeg-static e depois no PATH do sistema.
FFMPEG_PATH=""

# Voz -----------------------------------------------------------------------
ELEVENLABS_API_KEY=""

# Aplicação -----------------------------------------------------------------
PORT="3000"
APP_URL=""
